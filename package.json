{
  "name": "galaxy-tycoon",
  "private": true,
  "version": "1.0.0",
  "description": "Galaxy Tycoon - a single-player, fully client-side space mining and empire game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
